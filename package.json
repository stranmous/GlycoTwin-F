{
  "name": "glycotwin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "mobile": "pnpm --filter @glycotwin/mobile",
    "api": "echo 'Use: cd apps/api && uv run uvicorn app.main:app --reload'",
    "video:studio": "pnpm --filter @glycotwin/launch-video studio",
    "video:still": "pnpm --filter @glycotwin/launch-video still",
    "video:render": "pnpm --filter @glycotwin/launch-video render",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
