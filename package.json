{
  "name": "glycotwin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "mobile": "pnpm --filter @glycotwin/mobile",
    "backend": "cd backend && uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir app",
    "api": "cd backend && uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir app",
    "fetch-weights": "python scripts/fetch_weights.py",
    "video:studio": "pnpm --filter @glycotwin/launch-video studio",
    "video:still": "pnpm --filter @glycotwin/launch-video still",
    "video:render": "pnpm --filter @glycotwin/launch-video render",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
