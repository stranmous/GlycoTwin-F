# --- Server ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8081,http://127.0.0.1:8081,exp://

# --- Database ---
DATABASE_URL=postgresql+asyncpg://glycotwin:glycotwin@localhost:5432/glycotwin

# --- Firebase Admin ---
# Path to the service-account JSON downloaded from Firebase console.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# In dev you may set this to "true" to skip token verification (DO NOT use in prod).
AUTH_DEV_BYPASS=false
# Firebase Storage bucket — find it in Firebase console → Storage → "gs://<bucket>" name.
# Example: glycotwin-1.firebasestorage.app
# Leave blank to store images on local disk instead.
FIREBASE_STORAGE_BUCKET=

# --- Gemini (Coach) ---
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCb_bblr46VXMQq-rpCRIRVtHxJXzZ2xpo
GEMINI_MODEL=gemini-2.5-flash

# --- Storage ---
# Local disk fallback when FIREBASE_STORAGE_BUCKET is not set.
MEAL_IMAGE_DIR=./var/meal-images
