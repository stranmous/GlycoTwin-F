# --- Server ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://

# --- Database ---
DATABASE_URL=postgresql+asyncpg://glycotwin:glycotwin@localhost:5432/glycotwin

# --- Firebase Admin ---
# Path to the service-account JSON downloaded from Firebase console.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# In dev you may set this to "true" to skip token verification (DO NOT use in prod).
AUTH_DEV_BYPASS=false

# --- Gemini (Coach) ---
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Storage ---
# Local disk in dev; swap to S3/GCS in prod.
MEAL_IMAGE_DIR=./var/meal-images
